# ─────────────────────────────────────────────
# EchoChamber — Root .gitignore
# ─────────────────────────────────────────────

# ── Environment / Secrets ─────────────────────
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# ── Dependencies ──────────────────────────────
node_modules/
**/node_modules/

# ── Build output ──────────────────────────────
dist/
dist-ssr/
build/

# ── Logs ──────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS / Editor ───────────────────────────────
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
