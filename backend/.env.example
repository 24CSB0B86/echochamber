# ─────────────────────────────────────────────
# EchoChamber Backend — Environment Variables
# Copy this file to .env and fill in your values.
# See README.md for setup instructions.
# ─────────────────────────────────────────────

# ── Supabase ──────────────────────────────────
# From: https://supabase.com → Your Project → Settings → API
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
# From: Settings → API → service_role key (keep secret — server-side only)
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# ── Redis (Upstash) ───────────────────────────
# From: https://console.upstash.com → Create Database → Redis
# Use the "ioredis" connection URL format (rediss:// for TLS)
REDIS_URL=rediss://default:<your-upstash-password>@<your-upstash-host>.upstash.io:6379

# ── Server ────────────────────────────────────
PORT=3001

# ── CORS ──────────────────────────────────────
# The URL your frontend runs on (Vite default: 5173)
FRONTEND_URL=http://localhost:5173

# ── Groq (LLM reframing) ──────────────────────
# From: https://console.groq.com → API Keys → Create API Key
# Used for personality-aware message reframing (Prompt 3).
# If not set, reframing falls back to raw message content (chat still works).
# Recommended model: qwen/qwen3.8-27b (best available on Groq as of Nov 2026)
GROQ_API_KEY=gsk_<your-groq-api-key>
